# Скопируйте в .env и заполните. Файл .env не коммитится.

# Секрет подписи JWT: не короче 32 байт. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes

# PostgreSQL (используется в docker-compose)
POSTGRES_DB=studytrack
POSTGRES_USER=studytrack
POSTGRES_PASSWORD=change-me

# Адрес, по которому открывается сайт (для ссылок в письмах и CORS)
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Почта для напоминаний и восстановления пароля (внешний SMTP).
# Если SMTP_HOST пустой, письма не отправляются, а пишутся в журнал backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StudyTrack <no-reply@example.com>
SMTP_STARTTLS=true

# Часовой пояс по умолчанию для новых пользователей
DEFAULT_TIMEZONE=Europe/Moscow
